# Copy to .env (git-ignored) and fill in. Empty values use the built-in defaults.

# Free Auth-Key from https://auth.abuse.ch/ — enables the URLhaus feed sync.
OPENVERDICT_URLHAUS_AUTH_KEY=

# Optional: Google Safe Browsing. Sends checked URLs to Google; non-commercial terms only.
OPENVERDICT_SAFE_BROWSING_ENABLED=false
OPENVERDICT_SAFE_BROWSING_API_KEY=

OPENVERDICT_LOG_LEVEL=INFO
POSTGRES_PASSWORD=openverdict
GRAFANA_ADMIN_PASSWORD=admin
