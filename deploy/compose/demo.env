# Offline demo: synthetic feeds served by the demo-feeds container (no abuse.ch key needed).
#   docker compose --env-file deploy/compose/demo.env up -d --build
COMPOSE_PROFILES=demo
OPENVERDICT_URLHAUS_URL=http://demo-feeds/urlhaus/recent.csv
OPENVERDICT_PHISHING_DB_LINKS_URL=http://demo-feeds/phishing/links.txt
OPENVERDICT_PHISHING_DB_DOMAINS_URL=http://demo-feeds/phishing/domains.txt
OPENVERDICT_TRANCO_URL=http://demo-feeds/tranco/top-1m.csv
# Recover a killed worker's job within ~30 s instead of 5 min, so the demo can show it.
OPENVERDICT_JOB_RECLAIM_IDLE_SECONDS=30
OPENVERDICT_JOB_SWEEP_AFTER_SECONDS=30
